# Copy to .env.local. With no Supabase values the app runs in demo mode on seeded in-memory data.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (PostgreSQL + Auth + Storage). All three enable production mode. ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documents

# Signs demo-mode sessions. Required in production if Supabase is not configured.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- AI provider. Without a key, the deterministic rules engine is used. ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# --- Background worker. Vercel Cron sends this as a Bearer token to /api/cron/worker. ---
CRON_SECRET=

# Comma-separated emails promoted to admin on sign-in (bootstrap a fresh project).
ADMIN_EMAILS=

# Password assigned to every account created by `npm run seed` (Supabase mode only).
SEED_DEMO_PASSWORD=
